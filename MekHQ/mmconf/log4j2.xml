<?xml version="1.0" encoding="utf-8"?>
<Configuration status="info">
    <Properties>
        <Property name="layout">%d{ABSOLUTE} %-5p [%logger{36}] {%t}%n%l - %m%n%ex%n</Property>
        <Property name="tsvLayout">%d{ABSOLUTE}\t%p\t[%logger{36}]\t{%t}\t%l\t%m\t%ex%n</Property>
    </Properties>

    <Appenders>
        <RollingFile name="UnifiedLog"
                     fileName="logs/unified_log.log"
                     filePattern="logs/unified_log_%i.log.gz"
                     append="true"
                     bufferedIO="false">
            <PatternLayout pattern="${layout}" />
            <Policies>
                <OnStartupTriggeringPolicy minSize="1" />
                <SizeBasedTriggeringPolicy size="1MB" />
            </Policies>

            <DefaultRolloverStrategy max="10">
                <Delete basePath="logs" maxDepth="1">
                    <IfFileName regex="(unified_log|bot_path_ranker)_\d+\.log(\.gz)?$" />
                    <IfAccumulatedFileSize exceeds="15MB" />
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
        <RollingFile name="BotLog"
                     fileName="logs/bot_path_ranker.log"
                     filePattern="logs/bot_path_ranker_%i.log.gz"
                     append="true"
                     bufferedIO="false">
            <PatternLayout pattern="${tsvLayout}" />
            <Policies>
                <OnStartupTriggeringPolicy minSize="1" />
                <SizeBasedTriggeringPolicy size="1MB" />
            </Policies>

            <DefaultRolloverStrategy max="5">
                <Delete basePath="logs" maxDepth="1">
                    <IfFileName regex="(unified_log|bot_path_ranker)_\d+\.log(\.gz)?$" />
                    <IfAccumulatedFileSize exceeds="15MB" />
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
        <!--
          princess.log holds the bot (Princess and CASPAR) decision logging at info level. megamek.log, princess.log
          and mekhq.log roll over to <name>_N.log.gz at every launch and whenever they reach 20 MB, so the log of a
          stuck or crashed game survives MekHQ being started again. Up to 5 rolled files of each are kept, 50 MB at
          most. Report a Bug collects them.
        -->
        <RollingFile name="PrincessLog"
                     fileName="logs/princess.log"
                     filePattern="logs/princess_%i.log.gz"
                     append="true"
                     bufferedIO="false">
            <PatternLayout pattern="${layout}" />
            <Policies>
                <OnStartupTriggeringPolicy minSize="1" />
                <SizeBasedTriggeringPolicy size="20MB" />
            </Policies>
            <DefaultRolloverStrategy max="5">
                <Delete basePath="logs" maxDepth="1">
                    <IfFileName regex="princess_\d+\.log(\.gz)?$" />
                    <IfAccumulatedFileSize exceeds="50MB" />
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
        <RollingFile name="MegaMekLog"
                     fileName="logs/megamek.log"
                     filePattern="logs/megamek_%i.log.gz"
                     append="true"
                     bufferedIO="false">
            <PatternLayout pattern="${layout}" />
            <Policies>
                <OnStartupTriggeringPolicy minSize="1" />
                <SizeBasedTriggeringPolicy size="20MB" />
            </Policies>
            <DefaultRolloverStrategy max="5">
                <Delete basePath="logs" maxDepth="1">
                    <IfFileName regex="megamek_\d+\.log(\.gz)?$" />
                    <IfAccumulatedFileSize exceeds="50MB" />
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
        <File name="MegaMekLabLog" fileName="logs/megameklab.log" append="false">
            <PatternLayout pattern="${layout}" />
        </File>
        <RollingFile name="MekHQLog"
                     fileName="logs/mekhq.log"
                     filePattern="logs/mekhq_%i.log.gz"
                     append="true"
                     bufferedIO="false">
            <PatternLayout pattern="${layout}" />
            <Policies>
                <OnStartupTriggeringPolicy minSize="1" />
                <SizeBasedTriggeringPolicy size="20MB" />
            </Policies>
            <DefaultRolloverStrategy max="5">
                <Delete basePath="logs" maxDepth="1">
                    <IfFileName regex="mekhq_\d+\.log(\.gz)?$" />
                    <IfAccumulatedFileSize exceeds="50MB" />
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
        <Console name="dev">
            <PatternLayout pattern="${layout}" />
        </Console>
        <Null name="null" />
    </Appenders>

    <Loggers>
        <Logger name="megamek.client.bot" level="info" additivity="false">
            <AppenderRef ref="PrincessLog" />
            <AppenderRef ref="MegaMekLog" level="error" />
            <AppenderRef ref="${env:mm.profile:-null}" level="error" />
            <AppenderRef ref="UnifiedLog" level="error" />
        </Logger>
        <Logger name="BotLogger" level="info" additivity="false">
            <AppenderRef ref="BotLog" />
        </Logger>
        <Logger name="megamek" level="info" additivity="false">
            <AppenderRef ref="MegaMekLog" />
            <AppenderRef ref="${env:mm.profile:-null}" />
            <AppenderRef ref="UnifiedLog" />
        </Logger>
        <Logger name="megameklab" level="info" additivity="false">
            <AppenderRef ref="MegaMekLabLog" />
            <AppenderRef ref="${env:mm.profile:-null}" />
            <AppenderRef ref="UnifiedLog" />
        </Logger>
        <Logger name="mekhq" level="info" additivity="false">
            <AppenderRef ref="MekHQLog" />
            <AppenderRef ref="${env:mm.profile:-null}" />
            <AppenderRef ref="UnifiedLog" />
        </Logger>
        <Root level="info">
            <AppenderRef ref="MekHQLog" />
            <AppenderRef ref="${env:mm.profile:-null}" />
            <AppenderRef ref="UnifiedLog" />
        </Root>
    </Loggers>
</Configuration>
