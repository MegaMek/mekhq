                    <howMuch>2</howMuch>
                </failureEffect>
            </failureEffects>
            <additionalDetails />
            <description>Get 50% of the following forces to the far edge. +2 SVP if succeeded, -2 SVP if failed.</description>
            <destinationEdge>NORTH</destinationEdge>
